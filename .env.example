# PostgreSQL（docker compose up -d 或本机 PG 均可）
VS_DATABASE_URL=postgresql+psycopg://vs:vs@127.0.0.1:5432/vs
# 集成测试用的库（为空则跳过 DB 测试）
# VS_TEST_DATABASE_URL=postgresql+psycopg://vs:vs@127.0.0.1:5432/vs_test

# API & Auth
VS_ENVIRONMENT=dev
# 生产环境（VS_ENVIRONMENT != dev）必须配置至少 32 字符的随机密钥
# VS_JWT_SECRET=
# 生产环境通过 HTTPS 传输 Cookie 时设为 true
# VS_COOKIE_SECURE=false
VS_CORS_ORIGINS=["http://localhost:5173"]
# 由 API 进程托管构建好的 SPA（单进程部署时设置）
# VS_WEB_DIST=../web/dist

# Parquet 行情与财报事实库根目录（默认仓库根目录下的 data/market）
# VS_DATA_DIR=./data/market
# 外部行情数据源单次调用超时（秒）与最大重试次数
# VS_MARKET_SYNC_TIMEOUT_SECONDS=20.0
# VS_MARKET_SYNC_MAX_ATTEMPTS=3
